+/* DC-002.39e: el SEMIESPACIO del GC de Go -- el mismo `gsemi= usado/tope` de las marcas ARQ-CARGA (que lo
+ * sacan de `gc_stats()` de runtime/gc_heap.c). Es la otra memoria: la que la evidencia de DC-002.43 mide
+ * llenandose con la lectura COMPLETA de un asset. Aca se usa para ver con cuanta memoria entra el
+ * `ReadFile("(listfile)")` que se lleva la corrida puesta. */
+void gc_stats(size_t *used, size_t *total, uint32_t *collections);
+
+static void d2c_gc(size_t *u, size_t *t, uint32_t *c) {
+    *u = 0; *t = 0; *c = 0;
+    gc_stats(u, t, c);
+}
+
+int d2c_semi_usado(void) {
+    size_t u, t; uint32_t c;
+    d2c_gc(&u, &t, &c);
+    return (int)u;
+}
+
+int d2c_semi_tope(void) {
+    size_t u, t; uint32_t c;
+    d2c_gc(&u, &t, &c);
+    return (int)t;
+}
+
+int d2c_gc_cuenta(void) {
+    size_t u, t; uint32_t c;
+    d2c_gc(&u, &t, &c);
+    return (int)c;
+}
